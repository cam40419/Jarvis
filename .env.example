JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_STORAGE_BACKEND=memory
JARVIS_PUBLIC_ORIGIN=http://localhost:8000
JARVIS_RP_ID=localhost
JARVIS_DEV_LOGIN_ENABLED=false
# Set JARVIS_DEV_LOGIN_TOKEN to a random value (32+ characters) only when enabling dev login.
JARVIS_SESSION_HOURS=8
JARVIS_DATABASE_URL=postgresql://jarvis:local-development-only@127.0.0.1:5432/jarvis
JARVIS_OPENAI_API_KEY=your-openai-api-key-here
JARVIS_MODEL_PROVIDER=openai
JARVIS_OPENAI_MODEL=gpt-5.4-mini
JARVIS_MODEL_MAX_OUTPUT_TOKENS=2048
JARVIS_MODEL_INPUT_TOKEN_LIMIT=20000
