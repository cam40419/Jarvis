SIMON_ENVIRONMENT=development
SIMON_LOG_LEVEL=INFO
SIMON_STORAGE_BACKEND=memory
SIMON_PUBLIC_ORIGIN=http://localhost:8000
SIMON_RP_ID=localhost
# Remote deployment uses /simon; leave empty for localhost.
SIMON_PUBLIC_PATH=
SIMON_DEV_LOGIN_ENABLED=false
# Set SIMON_DEV_LOGIN_TOKEN to a random value (32+ characters) only when enabling dev login.
SIMON_SESSION_HOURS=8
SIMON_DATABASE_URL=postgresql://jarvis:local-development-only@127.0.0.1:5432/jarvis
SIMON_OPENAI_API_KEY=your-openai-api-key-here
SIMON_MODEL_PROVIDER=openai
SIMON_OPENAI_MODEL=gpt-5.4-mini
SIMON_DEEP_MODEL=gpt-5.4
SIMON_AUTO_DEEP_ENABLED=true
# Quick output cap; Balanced uses 8192, Deep uses 16384 (includes reasoning tokens).
SIMON_MODEL_MAX_OUTPUT_TOKENS=2048
SIMON_MODEL_INPUT_TOKEN_LIMIT=20000
SIMON_WEB_SEARCH_ENABLED=true
SIMON_VOICE_ENABLED=true
SIMON_VOICE_MODEL=gpt-live-1
SIMON_VOICE_NAME=cedar
SIMON_VOICE_MAX_SECONDS=900
# Optional Google connection. Import a downloaded Web OAuth client using:
# python -m simon.google_setup --client-file "path/to/client_secret.json"
# See docs/runbooks/google.md. Never commit the downloaded client or real token key.
SIMON_GOOGLE_CLIENT_ID=
SIMON_GOOGLE_CLIENT_SECRET=
SIMON_GOOGLE_TOKEN_KEY=
# LIFX/Tuya are discovered automatically. No cloud device inventory file is needed.
SIMON_HOME_AUTO_DISCOVERY=true
# Local launcher selects its development household automatically. For other deployments:
# SIMON_HOME_HOUSEHOLD_ID=your-household-uuid
# Optional legacy/Shelly inventory only. Keep it in .local/; omit until created.
# SIMON_HOME_DEVICES_FILE=.local/home-devices.json
SIMON_LIFX_TOKEN=
SIMON_TUYA_CLIENT_ID=
SIMON_TUYA_CLIENT_SECRET=
# Match the project's data center: us (alias us-west), us-east, eu, eu-west, cn, in.
SIMON_TUYA_REGION=us
SIMON_SHELLY_PASSWORD=

# Shelly local device Authentication password (admin), not the cloud or Wi-Fi password.
# Blank works only when local device authentication is disabled.
SIMON_SHELLY_LAN_DISCOVERY=true
SIMON_POWER_MONITORING_ENABLED=true
SIMON_POWER_POLL_SECONDS=60
SIMON_POWER_RETENTION_DAYS=90
