FROM python:3.11-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 worker \
    && useradd --uid 1000 --gid 1000 --no-create-home worker

WORKDIR /workspace
USER 1000:1000
ENTRYPOINT ["/bin/sleep"]
CMD ["infinity"]
