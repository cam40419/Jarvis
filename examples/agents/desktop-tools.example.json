{
  "environments": [
    {
      "id": "creative-desktop",
      "kind": "machine",
      "os": "windows",
      "capabilities": ["desktop.windows.uia", "application.control"],
      "enabled": false,
      "container_image": null,
      "runner_url": "https://desktop-runner.example.com",
      "credential_env": "SIMON_DESKTOP_RUNNER_TOKEN",
      "cpu_limit": 2.0,
      "memory_mb": 2048,
      "gpu_devices": [],
      "network": "bridge",
      "max_concurrency": 1,
      "container_uid": 1000,
      "container_gid": 1000
    }
  ],
  "tools": [
    {
      "id": "desktop.inspect",
      "description": "Inspect accessible controls in the operator-selected Windows application.",
      "categories": ["desktop", "applications"],
      "capabilities": [],
      "transport": "application",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "output_schema": {
        "type": "object"
      },
      "enabled": false,
      "configured": false,
      "required_scopes": ["jobs:write"],
      "environment_capabilities": ["desktop.windows.uia", "application.control"],
      "side_effect": true,
      "action_policy": "write",
      "endpoint": null,
      "credential_env": null,
      "settings": {
        "application": "windows-uia",
        "operation": "inspect",
        "network": true,
        "argv_prefix": ["C:\\SimonWorker\\venv\\Scripts\\python.exe", "-m", "simon.desktop_bridge"]
      }
    },
    {
      "id": "desktop.invoke",
      "description": "Invoke an accessible control using the exact state returned by desktop.inspect.",
      "categories": ["desktop", "applications"],
      "capabilities": [],
      "transport": "application",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "maxItems": 16
          },
          "expected_state": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["control_id", "expected_state"]
      },
      "output_schema": {
        "type": "object"
      },
      "enabled": false,
      "configured": false,
      "required_scopes": ["jobs:write"],
      "environment_capabilities": ["desktop.windows.uia", "application.control"],
      "side_effect": true,
      "action_policy": "write",
      "endpoint": null,
      "credential_env": null,
      "settings": {
        "application": "windows-uia",
        "operation": "invoke",
        "network": true,
        "argv_prefix": ["C:\\SimonWorker\\venv\\Scripts\\python.exe", "-m", "simon.desktop_bridge"]
      }
    },
    {
      "id": "desktop.set_text",
      "description": "Set an editable control's text using the exact state from desktop.inspect.",
      "categories": ["desktop", "applications"],
      "capabilities": [],
      "transport": "application",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "maxItems": 16
          },
          "expected_state": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": ["control_id", "expected_state", "text"]
      },
      "output_schema": {
        "type": "object"
      },
      "enabled": false,
      "configured": false,
      "required_scopes": ["jobs:write"],
      "environment_capabilities": ["desktop.windows.uia", "application.control"],
      "side_effect": true,
      "action_policy": "write",
      "endpoint": null,
      "credential_env": null,
      "settings": {
        "application": "windows-uia",
        "operation": "set_text",
        "network": true,
        "argv_prefix": ["C:\\SimonWorker\\venv\\Scripts\\python.exe", "-m", "simon.desktop_bridge"]
      }
    }
  ]
}
