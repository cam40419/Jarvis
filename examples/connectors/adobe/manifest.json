{
  "manifestVersion": 5,
  "id": "simon-creative-bridge",
  "name": "Simon Creative Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    { "app": "PS", "minVersion": "25.0.0", "data": { "apiVersion": 2 } },
    { "app": "premierepro", "minVersion": "25.6.0" }
  ],
  "requiredPermissions": { "localFileSystem": "request" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "simonBridge",
      "label": { "default": "Simon Bridge" },
      "minimumSize": { "width": 280, "height": 180 }
    }
  ]
}
