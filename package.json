{
  "name": "simon-development-tools",
  "private": true,
  "scripts": {
    "format": "prettier --write \"src/simon/api/static/**/*.{js,css,html}\" \"docs/**/*.md\" README.md \"examples/agents/*.json\" \".github/workflows/*.yml\" package.json .prettierrc.json eslint.config.mjs \"deploy/**/*.{json,yaml,yml}\" \"db/schema/*.md\" \"examples/connectors/**/*.{js,json,html}\" \"tests/connectors/*.cjs\"",
    "format:check": "prettier --check \"src/simon/api/static/**/*.{js,css,html}\" \"docs/**/*.md\" README.md \"examples/agents/*.json\" \".github/workflows/*.yml\" package.json .prettierrc.json eslint.config.mjs \"deploy/**/*.{json,yaml,yml}\" \"db/schema/*.md\" \"examples/connectors/**/*.{js,json,html}\" \"tests/connectors/*.cjs\"",
    "lint": "eslint src/simon/api/static examples/connectors/adobe tests/connectors",
    "test:connectors": "node --test tests/connectors/*.test.cjs"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
